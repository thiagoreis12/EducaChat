# Copie para .env e preencha. O .env NUNCA deve ser commitado (já está no .gitignore).

# OpenRouter (Fases 4-5)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase (Fase 5.5)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=


# Caminhos (opcional; valores padrão abaixo)
# BNCC_PDF_PATH=data/raw/BNCC_EI_EF_110518_versaofinal_site.pdf
# BNCC_JSON_PATH=data/processed/bncc_estruturada.json
# CHROMA_DIR=data/chroma
# LOG_DIR=logs
LOG_LEVEL=INFO

# Geração (Fase 5); mesmos valores para baseline e protótipo
# LLM_TEMPERATURA=0.3
# LLM_MAX_TOKENS=800
# RAG_K=5

# API (Fase 5.5)
# CORS_ORIGINS=["http://localhost:5173"]
# COOKIE_SECURE=false          # true em produção (HTTPS)
# COOKIE_SAMESITE=strict       # "none" + COOKIE_SECURE=true se front e API ficarem em domínios diferentes
# EXPOR_ROTA_BASELINE=false    # nunca true em produção
